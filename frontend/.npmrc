# The @helex-solutions packages live in GitHub Packages, which refuses anonymous
# reads. One-time setup (any of):
#   npm config set //npm.pkg.github.com/:_authToken=$(gh auth token) --global
#   # or put a classic PAT with read:packages in ~/.npmrc:
#   # //npm.pkg.github.com/:_authToken=ghp_yourtoken
@helex-solutions:registry=https://npm.pkg.github.com
